PORT=4000
JWT_SECRET=miniledger-super-secure-secret-key-2026-development

# PostgreSQL Connection String (e.g. postgres://postgres:postgres@localhost:5432/miniledger)
# If left empty or unreachable, MiniLedger will seamlessly run using its built-in in-memory PostgreSQL engine!
DATABASE_URL=postgres://postgres:postgres@localhost:5432/miniledger

# Or discrete connection parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=miniledger
PG_SSL=false

# Optional: set to true to force in-memory mock PostgreSQL engine without requiring local Postgres
USE_MEMORY_DB=false
